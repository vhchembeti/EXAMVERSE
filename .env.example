# ==============================================================================
# EXAMVERSE – Production Environment Configuration
# Project: EXAMVERSE (Every Exam. Every Opportunity. One Platform.)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# PORT: TCP port where Express server listens (default: 5000)
PORT=5000

# NODE_ENV: Server execution environment ('development', 'test', 'production')
NODE_ENV=production

# APP_URL: Public canonical application URL for CORS and statutory callbacks
APP_URL=https://examverse.onrender.com

# ------------------------------------------------------------------------------
# 2. PERSISTENT STORAGE (MANDATORY IN PRODUCTION ON RENDER)
# ------------------------------------------------------------------------------
# DATABASE_URL: PostgreSQL connection URI (Render Free Tier spins down / ephemeral local disk)
DATABASE_URL=postgresql://username:password@hostname:5432/examverse?sslmode=require

# SUPABASE_URL: Alternative managed PostgreSQL endpoint for zero-budget hosting
SUPABASE_URL=https://your-project.supabase.co

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI API (Server-Side Only - NEVER expose to client)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key for academic tutor and document intelligence
GEMINI_API_KEY=your_google_gemini_api_key_here

# API_KEY: Supported alias for Google Gemini API key
API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. GROQ & OLLAMA FALLBACK AI PROVIDERS
# ------------------------------------------------------------------------------
# GROQ_API_KEY: Secondary free-tier high-speed LLM fallback (Llama 3.3 70B)
GROQ_API_KEY=your_groq_free_tier_api_key_here

# ENABLE_OLLAMA: Activate local offline Ollama inference ('true' or 'false')
ENABLE_OLLAMA=false

# OLLAMA_BASE_URL: HTTP URL for local Ollama daemon
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OLLAMA_MODEL: Model tag to pull and run locally
OLLAMA_MODEL=qwen2.5:3b

# ------------------------------------------------------------------------------
# 5. SECURITY & ACCESS CONTROL
# ------------------------------------------------------------------------------
# ADMIN_SECRET_KEY: Secret key for /api/admin/* endpoints and verification workbench (min 16 chars)
ADMIN_SECRET_KEY=examverse_admin_secure_key_min_16_characters_2027

# ENCRYPTION_MASTER_KEY: 256-bit hexadecimal string for envelope encryption at rest (DPDP Act 2023)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# BLIND_INDEX_SALT: Cryptographic salt for privacy-preserving HMAC blind indexes
BLIND_INDEX_SALT=examverse_blind_index_salt_secure_2027

# MONITORING_WEBHOOK_SECRET: HMAC-SHA256 signature secret for external scheduled monitoring triggers
MONITORING_WEBHOOK_SECRET=monitoring_webhook_secret_examverse_2027

# RATE_LIMIT_MAX_REQUESTS: Maximum allowed requests per IP per window (Default: 300)
RATE_LIMIT_MAX_REQUESTS=300

# RATE_LIMIT_WINDOW_MS: Rate limit window duration in milliseconds (Default: 60000)
RATE_LIMIT_WINDOW_MS=60000
